//	RokuganUpdate.sk : the title screen's "Update / Verify" entry (user 2026-11-12: "add a new box on start screen. This
//	will have 2 options Update (which will keep track by version number on git (increment with each push) and verify
//	files (against Git) update being faster").
//	tools/release.py writes two files into the repo root on every push: version.json {version, date} and rt_manifest.json
//	{version, files: {path: [crc32, size]}} (every committed file but .exe/.dll, which are locked while the game runs).
//	- Update (fast): only the files whose manifest entry changed since the installed version, plus any missing or
//	  wrong-sized file. No file is read.
//	- Verify: every file's CRC32 against GitHub's manifest; anything that differs is downloaded again.
//	Each download is checked (CRC32 + size) before it replaces the old file. Afterwards the game asks to restart, since
//	scripts and data already loaded stay as they were.
//	A copy with no version.json (the developer's working folder) never updates: the button only says so.

local REPO = "https://raw.githubusercontent.com/akodoreign/Traveler/main/";
local log( s){ printf( "[RT] update: %S\n", s); }

::Rokugan.upd <- { views = [], lbl = null, tex = null };

//	The engine's file security (project/sakana.proj, permission_lv2) lets the game write only inside its own folder,
//	<repo>/_tools/rpgcobo-tool ($cdir), and never .exe/.dll/.bat/.ps1/sakana.proj. So the updater keeps exactly that part
//	of the repo - everything the game loads - and the installed version's record there too (rt_version.json,
//	rt_manifest.json). Docs and the developer tools come with a git pull / a fresh download.
local GAME = "_tools/rpgcobo-tool/";

//	The local file for a repo path, or null when the updater doesn't manage it.
::Rokugan.updPath <- function( p){
	if( p.indexOf( GAME) != 0) return null;
	local l = p.toLowerCase();
	foreach( x in [".exe", ".dll", ".bat", ".ps1", ".psm1", ".local", "sakana.proj"]){
		if( l.lastIndexOf( x) >= 0 && l.lastIndexOf( x) == length( l) - length( x)) return null;
	}
	return skGetCurrentDir() .. "/" .. p.substring( length( GAME));
};

//	raw.githubusercontent.com caches each URL for ~5 minutes; a fresh query string skips that cache, so a push is seen
//	right away and every file comes from the same version as the manifest.
::Rokugan.updUrl <- function( path){
	return REPO .. path.replace( " ", "%20") .. "?t=" .. ::Rokugan.updStamp;
};
::Rokugan.updStamp <- 0;

::Rokugan.updReadJSON <- function( full){
	try{
		local f = FileRef( full);
		if( !f.exists()) return null;
		return decodeJSON( f.load().asText());
	}catch( ex){ return null; }
};

//	The installed version's file: the game folder's own record (written by the last in-game update) or the repo
//	root's (a git clone / a downloaded zip), whichever is newer.
::Rokugan.updLocalJSON <- function( name){
	local a = this.updReadJSON( skGetCurrentDir() .. "/rt_" .. (name == "version.json" ? "version.json" : "manifest.json"));
	local b = this.updReadJSON( skGetCurrentDir() .. "/../../" .. name);
	if( !a) return b;
	if( !b) return a;
	return (a["version"] || 0) >= (b["version"] || 0) ? a : b;
};

::Rokugan.updCrcOk <- function( bb, want){
	return ("" .. bb.crc32( 0)) == ("" .. want);			//	(signed 32-bit, as a string: tools/release.py)
};

//	A one-line progress panel on top of everything (the title UI is darkened behind it).
::Rokugan.updShow <- function( s){
	local U = this.upd;
	if( !U.lbl){
		local root = ::rootview;
		local W = root.bnd.w, Ht = root.bnd.h, w = 760, h = 64, x = (W - w) / 2, y = Ht - h - 90;
		if( !U.tex){
			local img = ::getResource( "/resource/efx/battleui/white.png").getContent();
			img.premultAlpha();
			U.tex = Texture();
			U.tex.load( img, 0);
		}
		local sp = Sprite( U.tex);
		sp.blend = SK_PMAMIX;
		local bg = ::SKImageView( sp);
		bg.enabled = false; bg.setRect( x, y, w, h); bg.setColor( 0x0b0a12e0);
		root.addChild( bg); U.views .. bg;
		local v = SKLabelView( "", FontAttribute( Fonts.get( "ui"), 20, 0xf4f0e6ff, SK_FONT_BOLD));
		v.enabled = false; v.bnd.set( x + 20, y + 20, w - 40, 28);
		root.addChild( v); U.views .. v;
		U.lbl = v;
	}
	U.lbl.setText( s);
	suspend();
};

::Rokugan.updHide <- function(){
	local U = this.upd;
	foreach( v in U.views) if( v) v.removeFromParent();
	U.views = [];
	U.lbl = null;
};

::Rokugan.updGet <- function( path){
	local last = null;
	for( local t = 0; t < 3; t++){
		try{
			local http = HTTPClient();
			http.addHeader( "User-Agent", "RokuganTraveler-updater");
			http.addHeader( "Cache-Control", "no-cache");
			local bb = http.get( this.updUrl( path));
			if( http.statuscode != 200) throw "HTTP " .. http.statuscode;
			bb.pos = 0;
			return bb;
		}catch( ex){
			last = ex;
			log( "get %S failed (%d): %S" % (path, t + 1, string( ex)));
			sleep( 400);
		}
	}
	throw last;
};

::Rokugan.updWrite <- function( full, bb){
	local d = FileRef( dirname( full));
	if( !d.isDirectory()) d.mkdirs();					//	(mkdirs on an existing folder trips the file security)
	local f = FileRef( full);
	local s = f.open( "wb");
	bb.pos = 0;
	s.write( bb);
	s.close();
	f.refresh();
};

//	The files to fetch. fast: manifest entries changed since the installed manifest, plus missing / wrong-sized files.
//	Otherwise every file's CRC32 is checked.
::Rokugan.updScan <- function( remote, local_, fast){
	local need = [], n = 0, tot = length( remote.files);
	local lf = (local_ && local_["files"]) || {};
	foreach( p, e in remote.files){
		n++;
		local full = this.updPath( p);
		if( !full) continue;
		local f = FileRef( full);
		if( !f.exists()){ need .. p; continue; }
		//	boss / banner art: GitHub has placeholders (the wiki-derived originals never go there) - a copy that has the
		//	real picture keeps it
		local fn = p.substring( p.lastIndexOf( "/") + 1);
		if( (fn.indexOf( "boss_") == 0 || fn.indexOf( "banner_") == 0)
			&& (p.indexOf( "resource/enemy_pic/") >= 0 || p.indexOf( "resource/efx/portrait/") >= 0)) continue;
		if( fast){
			//	only what changed on GitHub since the installed version (a local edit that GitHub hasn't changed stays)
			local o = (p in lf) ? lf[p] : null;
			if( !o ? f.size != e[1] : (o[0] != e[0] || o[1] != e[1])) need .. p;
			if( n % 400 == 0) this.updShow( "Comparing files... %d / %d" % (n, tot));
			continue;
		}
		if( f.size != e[1] || !this.updCrcOk( f.load(), e[0])) need .. p;
		if( n % 25 == 0) this.updShow( "Verifying files... %d / %d (%d to fix)" % (n, tot, length( need)));
	}
	return need;
};

//	Downloads the listed files (each checked against the manifest before it replaces the old one); when all of them
//	landed, records the installed version in the game folder. Returns { ok = count, bad = [paths] }.
::Rokugan.updApply <- function( remote, need){
	local ok = 0, bad = [];
	foreach( i, p in need){
		this.updShow( "Downloading %d / %d: %S" % (i + 1, length( need), p.substring( p.lastIndexOf( "/") + 1)));
		try{
			local bb = this.updGet( p), e = remote.files[p];
			if( bb.size != e[1] || !this.updCrcOk( bb, e[0])) throw sprintf( "the download doesn't match the manifest"
				.. " (size %d/%S, crc %d/%S %S)", bb.size, "" .. e[1], bb.crc32( 0), "" .. e[0], typeof( e[0]));
			this.updWrite( this.updPath( p), bb);
			ok++;
		}catch( ex){
			log( "%S: %S" % (p, string( ex)));
			bad .. p;
		}
	}
	if( !length( bad)){
		this.updWrite( skGetCurrentDir() .. "/rt_manifest.json", this.updGet( "rt_manifest.json"));	//	(for the next fast update)
		this.updWrite( skGetCurrentDir() .. "/rt_version.json", this.updGet( "version.json"));
	}
	return { ok = ok, bad = bad };
};

::Rokugan.updRun <- function( runner, fast){
	this.updShow( "Downloading the file list from GitHub...");
	local remote = decodeJSON( this.updGet( "rt_manifest.json").asText());
	local need = this.updScan( remote, this.updLocalJSON( "rt_manifest.json"), fast);
	log( "%S: %d files to fetch" % (fast ? "update" : "verify", length( need)));
	local res = this.updApply( remote, need), ok = res.ok, bad = res.bad;
	this.updHide();
	local v = remote["version"];
	if( length( bad)){
		runner.showMessage( { key = "message_talk", name = "", uiclose = 2, text = sprintf(
			"Fixed %d files, but %d could not be replaced (first: %S). Close the game and choose Update again.",
			ok, length( bad), bad[0]) });
		return;
	}
	if( !ok){
		runner.showMessage( { key = "message_talk", name = "", uiclose = 2, text = fast
			? sprintf( "Already up to date (version %d).", v)
			: sprintf( "Every game file matches GitHub (version %d).", v) });
		return;
	}
	runner.showMessage( { key = "message_talk", name = "", uiclose = 2, text = sprintf(
		"%d files updated to version %d. The game must restart to load them.", ok, v) });
	local r = runner.showChoices( { backenable = false, cmdblocks = [[], []], text0 = "Close the game now", text1 = "Later" });
	if( r == 0) skExit( 0);
};

//	Called by the title menu's Update / Verify entry (tools/gen_data.py, map M000).
::Rokugan.updateMenu <- function( runner){
	this.updStamp = skGetTime() .. "x" .. int( ::rnd.nextf( 0.0, 1000000.0));
	this.updNoticeHide();
	local mine = this.updLocalJSON( "version.json");
	if( !mine){
		runner.showMessage( { key = "message_talk", name = "", uiclose = 2,
			text = "This copy doesn't know its version yet. Choose Verify all files once, then Update works." });
		local r0 = runner.showChoices( { backenable = true, cmdblocks = [[], []], text0 = "Verify all files", text1 = "Back" });
		if( r0 != 0) return;
		try{ this.updRun( runner, false); }catch( ex){
			this.updHide();
			printexception( ex);
			runner.showMessage( { key = "message_talk", name = "", uiclose = 2,
				text = "The update stopped: " .. string( ex) .. ". Nothing half-written was kept; try again." });
		}
		return;
	}
	local theirs = null;
	try{
		this.updShow( "Checking GitHub for a new version...");
		theirs = decodeJSON( this.updGet( "version.json").asText());
	}catch( ex){
		this.updHide();
		runner.showMessage( { key = "message_talk", name = "", uiclose = 2,
			text = "Couldn't reach GitHub (" .. string( ex) .. "). Check the internet connection and try again." });
		return;
	}
	this.updHide();
	local lv = mine["version"] || 0, rv = theirs["version"] || 0;
	runner.showMessage( { key = "message_talk", name = "", uiclose = 2, text = sprintf(
		"Installed: version %d.  On GitHub: version %d.%S", lv, rv, rv > lv ? "  An update is ready." : "") });
	local r = runner.showChoices( { backenable = true, cmdblocks = [[], [], []],
		text0 = "Update (fast)", text1 = "Verify all files", text2 = "Back" });
	if( r != 0 && r != 1) return;
	try{
		this.updRun( runner, r == 0);
	}catch( ex){
		this.updHide();
		printexception( ex);
		runner.showMessage( { key = "message_talk", name = "", uiclose = 2,
			text = "The update stopped: " .. string( ex) .. ". Nothing half-written was kept; try again." });
	}
};

//	(user 2026-11-14: "sneak in some yellow text on screen letting players know an update is available when they launch")
//	The title screen (map M000) checks GitHub's version.json in the background; when it is newer than the installed
//	version, a yellow line shows on the title until another map loads. No connection: nothing shows.
::Rokugan.updNotice <- null;
::Rokugan.updNoticeHide <- function(){
	if( this.updNotice){ this.updNotice.removeFromParent(); this.updNotice = null; }
};
::Rokugan.updNoticeCheck <- function(){
	local mine = this.updLocalJSON( "version.json");
	if( !mine || ::arguments.indexOf( "-rtnoupdcheck") >= 0) return;
	newthread().start( @(){
		try{
			::Rokugan.updStamp = skGetTime() .. "n" .. int( ::rnd.nextf( 0.0, 1000000.0));
			local http = HTTPClient();
			http.addHeader( "User-Agent", "RokuganTraveler-updater");
			local bb = http.get( ::Rokugan.updUrl( "version.json"));
			if( http.statuscode != 200) return;
			local theirs = decodeJSON( bb.asText()), lv = mine["version"] || 0, rv = theirs["version"] || 0;
			log( "title check: installed %d, GitHub %d" % (lv, rv));
			if( rv <= lv || !::rpgstage || ::rpgstage.mapid != "M000" || ::Rokugan.updNotice) return;
			local root = ::rootview, W = root.bnd.w, Ht = root.bnd.h;
			local v = SKLabelView( "", FontAttribute( Fonts.get( "ui"), 22, 0xffd84aff, SK_FONT_BOLD));
			v.enabled = false;
			v.bnd.set( 40, Ht - 92, W - 80, 30);
			v.setText( "Update available: version %d (you have %d). Choose Update / Verify on the menu." % (rv, lv));
			root.addChild( v);
			::Rokugan.updNotice = v;
		}catch( ex){
			log( "title check failed: " .. string( ex));
		}
	});
};
::RPGStage._rt_launch_upd <- ::RPGStage.launch;
::RPGStage.launch <- function( opt = null){
	try{
		if( this.mapid == "M000") ::Rokugan.updNoticeCheck(); else ::Rokugan.updNoticeHide();
	}catch( ex){ printexception( ex); }
	return this._rt_launch_upd( opt);
};

//	-rtupdtest fast|verify|fix : runs the updater from the launch hook against GitHub (no title menu, no messages).
//	fast / verify only list what they would fetch; fix verifies and downloads.
::Rokugan.updTest <- function( mode){
	this.updStamp = skGetTime() .. "x" .. int( ::rnd.nextf( 0.0, 1000000.0));
	try{
		local t0 = skGetTime();
		local remote = decodeJSON( this.updGet( "rt_manifest.json").asText());
		local vbb = this.updGet( "version.json");
		log( "remote version %S, %d files; version.json crc %d size %d; local version %S"
			% (remote["version"], length( remote.files), vbb.crc32( 0), vbb.size, encodeJSON( this.updLocalJSON( "version.json"))));
		local need = this.updScan( remote, this.updLocalJSON( "rt_manifest.json"), mode == "fast");
		log( "scan %S: %d to fetch in %d ms %S" % (mode, length( need), skGetTime( t0), encodeJSON( need.slice( 0, Math.min( 10, length( need))))));
		if( mode == "fix"){
			local res = this.updApply( remote, need);
			log( "fixed %d, failed %S" % (res.ok, encodeJSON( res.bad)));
		}
		log( "TEST done in %d ms" % skGetTime( t0));
	}catch( ex){
		printexception( ex);
		log( "TEST failed: " .. string( ex));
	}
	this.updHide();
};
