//	RokuganMarker.sk : the floating quest marker (user 2026-11-14: "add a floating quest marker (maybe a white/silver
//	sparkly cross mixed with a star) that shows you where to go next according to your currently selected quest, edge of
//	screen taking the player to the next map over, to a door, etc. It needs to float so it can go to a cave or tree").
//	Data: RokuganMarkerData.sk (tools/gen_maps.py marker_pass). Model: EP361 (tools/gen_questmarker.py).
//	Target: the Journal's tracked quest (G1244 > 0: its giver, then where the work is, then the giver again), else the
//	main story: the next once-scene on the leader's road whose conditions hold. On another map: the way out toward it
//	(a door, a portal, or the stretch of map edge nearest the player). -rtnomarker turns it off.
::Rokugan.mk <- { obj = null, stage = null, t = 0.0, goal = null, at = null, key = "" };

::Rokugan.mkReq <- function( r){
	local v = ::rpgvar[r[0]], w = r[2];
	if( v == null) v = (typeof( w) == "bool") ? false : 0;
	switch( r[1]){
	case "==": return v == w;
	case "!=": return v != w;
	case ">": return v > w;
	case "<": return v < w;
	case ">=": return v >= w;
	case "<=": return v <= w;
	}
	return false;
};
::Rokugan.mkReqs <- function( rs){ foreach( r in rs) if( !this.mkReq( r)) return false; return true; };

//	map distances from `from` over every link (doors and story moves), and the first map on the way to each
::Rokugan.mkRoad <- function( from){
	local dist = {}, first = {}, q = [from];
	dist[from] <- 0;
	for( local i = 0; i < length( q); i++){
		local cur = q[i];
		if( !(cur in this.MK_LINKS)) continue;
		foreach( nx in this.MK_LINKS[cur]){
			if( nx in dist) continue;
			local gk = cur .. ">" .. nx;										//	(user: "they are being directed down
			if( ("MK_GATES" in this) && (gk in this.MK_GATES)){			//	closed routes") a shut door is no road;
				local open = false;												//	(every way between two maps is listed:
				foreach( alt in this.MK_GATES[gk]) if( this.mkReqs( alt)){ open = true; break; }	//	open if any is)
				if( !open) continue;
			}
																			//	routes") a shut door is no road
			dist[nx] <- dist[cur] + 1;
			first[nx] <- cur == from ? nx : first[cur];
			q.append( nx);
		}
	}
	return { dist = dist, first = first };
};

//	the goal: [map, x, z] or null
::Rokugan.mkGoal <- function( cur, road){
	local tid = int( ::rpgvar["G1244"] || 0);
	if( tid > 0 && ("JOURNAL_QUESTS" in ::Rokugan) && (tid in this.MK_QUEST)){
		local q = this.JOURNAL_QUESTS.filter( @( v) v.id == tid);
		local t = this.MK_QUEST[tid];
		if( length( q)){
			q = q[0];
			if( !::rpgvar[q.done]){
				local ix = (::rpgvar[q.taken] && !::rpgvar[q.hunted]) ? 3 : 0;
				if( t[ix] in road.dist) return [t[ix], t[ix+1], t[ix+2]];
			}
		}
		//	(tester 2026-11-14) the hand-written side stories, ids 1-10 (JOURNAL_SIDE): the place that finishes them
		local s = ("JOURNAL_SIDE" in ::Rokugan) ? this.JOURNAL_SIDE.filter( @( v) v.id == tid) : [];
		if( length( s) && !::rpgvar[s[0].done]) return [t[0], t[1], t[2]];
	}
	//	(whose road: the first traveler in the party - Formation can put a companion in slot 1)
	local pid = ("journalLead" in this) ? this.journalLead() : null;
	if( !pid){ local lead = ::rpgstat.members.find( @( v) v); pid = lead ? lead.dataid : null; }
	local best = null, bs = -1, bd = 9999;
	foreach( pass in [0, 1]){											//	(an "opener" - what opens a shut door on
	if( best) break;													//	the way - only when no story beat is due)
	foreach( b in this.MK_BEATS){
		if( (length( b) > 4 && b[4] == "opener") != (pass == 1)) continue;
		local mp = b[0];
		if( pid && (mp in this.MK_PATH) && this.MK_PATH[mp] != pid
			&& (!(mp in this.MK_SHARED_PATH) || this.MK_SHARED_PATH[mp].indexOf( pid) < 0)) continue;
		if( !(mp in this.MK_PATH) && !::rpgvar["G1363"]) continue;		//	the finale's maps: only in the finale
		if( !(mp in road.dist)) continue;
		if( !this.mkReqs( b[3])) continue;
		local spec = 0, d = road.dist[mp];									//	the furthest-along beat (most story
		foreach( i, r in b[3]) if( i > 0 && ((r[1] == "==" && r[2] == true) || r[1] == ">" || r[1] == ">="	//	flags it
			|| (r[1] == "!=" && (r[2] == false || r[2] == 0)))) spec++;		//	needs set), then the nearest
		if( spec > bs || (spec == bs && d < bd)){ best = b; bs = spec; bd = d; }
	}
	}
	if( !best) return null;
	local g = [best[0], best[1], best[2]];
	local rg = this.mkRestGoal( cur, g, road);							//	(a rest: the nearest innkeeper)
	return rg ? rg : g;
};

//	(user 2026-11-24: "move quest markers like rest to the nearest inkeeper, set his price to always be 0 and trigger the
//	quests rest. i saw several times where the marker was in front of a place or just in the middle of the street")
//	A rest objective ("Rest at the inn tonight", "Haruki should sleep", ...): the marker goes to the nearest innkeeper
//	(MK_INNS, by road from where the night's scene is, at most 3 maps from it) instead of the scene's spot; resting
//	there (free: macro X014) runs that scene (innRestQuest).
::Rokugan.mkRestBeat <- null;
::Rokugan.mkRestCache <- { key = "", val = null, beat = null };
::Rokugan.mkIsRest <- function(){
	local oi = int( ::rpgvar["G1227"] || 0) - 1, objs = this["OBJECTIVES"] || [];
	if( oi < 0 || oi >= length( objs)) return false;
	local t = objs[oi];
	if( t.indexOf( "place to rest") >= 0) return false;
	foreach( w in ["Rest ", "Rest.", " rest ", " rest.", "sleep"]) if( t.indexOf( w) >= 0) return true;
	return false;
};
::Rokugan.mkRestGoal <- function( cur, g, road){
	if( !this.mkIsRest() || !("MK_INNS" in this)){ this.mkRestBeat = null; return null; }
	local C = this.mkRestCache, key = "%s|%s|%.1f|%.1f|%d" % [cur, g[0], g[1], g[2], int( ::rpgvar["G1227"] || 0)];
	if( C.key == key){ this.mkRestBeat = C.beat; return C.val; }
	local r = this.mkRoad( g[0]), best = null, bd = 4, br = 9999;
	foreach( im, p in this.MK_INNS){
		if( !(im in road.dist)) continue;								//	(one she can get to from here)
		local d = im == g[0] ? 0 : ((im in r.dist) ? r.dist[im] : 99);
		if( d < bd || (d == bd && road.dist[im] < br)){ bd = d; br = road.dist[im]; best = [im, p[0], p[1]]; }
	}
	C.key = key; C.val = best; C.beat = best ? g : null;
	this.mkRestBeat = C.beat;
	return best;
};

//	after a night at an inn (macro X014): the rest objective's own scene - on its map (moving there first), the event at
//	the beat's spot is run
::Rokugan.innRestQuest <- function(){
	if( !this.mkIsRest()) return;
	local st = ::rpgstage;
	if( !st) return;
	local keep = ::rpgvar["G1244"];
	::rpgvar["G1244"] = 0;												//	(the story's beat, not a tracked quest's)
	try{ this.mkGoal( st.mapid, this.mkRoad( st.mapid)); }catch( ex){ printexception( ex); }
	::rpgvar["G1244"] = keep;
	local beat = this.mkRestBeat;
	if( !beat){ printf( "[RT] inn rest: no scene due for this rest\n"); return; }
	printf( "[RT] inn rest: the night's scene at %S %.1f %.1f\n", beat[0], beat[1], beat[2]);
	newthread().start( @() ::Rokugan.innRestRun( beat));
};
::Rokugan.innRestRun <- function( beat){
	local t = 0;
	while( ::rpgstage && ::rpgstage.mainevent && t < 30000){ sleep( 100); t += 100; }
	sleep( 300);
	if( !::rpgstage || ::rpgstage.mainevent) return;
	if( ::rpgstage.mapid != beat[0]){
		::RPGMain.moveMap( { dest = { mapid = beat[0], pos = (beat[1], null, beat[2], 0.0) }, wipe = 1, remap = true });
		t = 0;
		while( t < 20000 && (!::rpgstage || ::rpgstage.mapid != beat[0] || !::rpgstage["player3d"])){ sleep( 200); t += 200; }
		sleep( 1000);
	}
	local st = ::rpgstage;
	if( !st || st.mainevent || st.mapid != beat[0]) return;				//	(arriving on it already ran it)
	local best = null, bd = 9.0;
	foreach( k, e in st.events){
		if( !e.rp3d || !e.page || !e.data || e.data["role"] == "portal") continue;
		if( int( e.page["trigger"] || 0) == 0) continue;
		local d = Math.pow( e.rp3d.pos.x - beat[1], 2) + Math.pow( e.rp3d.pos.z - beat[2], 2);
		if( d < bd){ bd = d; best = e; }
	}
	if( !best){ printf( "[RT] inn rest: nothing to run at %S %.1f %.1f\n", beat[0], beat[1], beat[2]); return; }
	local pi = best.pagelist.indexOf( best.page);
	printf( "[RT] inn rest: running %S\n", "" .. (best.data["name"] || "?"));
	if( pi >= 0) best.forceTrigger( pi);
};


//	where to float: the goal itself, or the way out toward its map
::Rokugan.mkPoint <- function( st, goal, road){
	local cur = st.mapid;
	if( goal[0] == cur) return [goal[1], goal[2]];
	if( !(goal[0] in road.first)) return null;
	local hop = road.first[goal[0]];
	if( !(cur in this.MK_EXITS)) return null;
	local p = st.player3d.pos, best = null, bd = 999999.0;			//	(no 1e9 literals in this dialect)
	//	(user: "on screens where there is no objectives the star should float at the edge ... where you are supposed
	//	to go") the hop may be a story move with no door on this map: then the walkable exit whose map is nearest the goal
	//	(a story move's exit - a futon whose late page has a scene - only while that page can run: 6th item)
	local open = this.MK_EXITS[cur].filter( @( e) length( e) < 6 || ::Rokugan.mkReqs( e[5]));
	local ways = open.filter( @( e) e[0] == hop);
	if( !length( ways)){
		local bestd = 9999;
		foreach( e in open){
			local r = this.mkRoad( e[0]), d = (goal[0] in r.dist) ? r.dist[goal[0]] : 9999;
			if( d < bestd){ bestd = d; hop = e[0]; }
		}
		ways = open.filter( @( e) e[0] == hop);
	}
	foreach( e in ways){
		//	the nearest point of the exit's box (an edge strip is long: float where the player would cross it)
		local x = Math.clamp( p.x, e[1] - e[3], e[1] + e[3]), z = Math.clamp( p.z, e[2] - e[4], e[2] + e[4]);
		local d = (x - p.x) * (x - p.x) + (z - p.z) * (z - p.z);
		if( d < bd){ bd = d; best = [x, z]; }
	}
	return best;
};

::Rokugan.mkHide <- function(){
	local k = this.mk;
	if( k.obj){ try{ k.obj.setVisible( false); }catch( ex){} }
};

::Rokugan.mkTick <- function( st, dt){
	local k = this.mk;
	if( ::arguments.indexOf( "-rtnomarker") >= 0 || !("MK_LINKS" in ::Rokugan)) return;
	if( st["battle"] || !st["player3d"] || !st["scn"] || st.mainevent){ this.mkHide(); return; }
	if( k.stage != st){												//	a new map: a new marker object
		k.stage = st; k.obj = null; k.goal = null; k.at = null; k.t = 0.0; k.key = "";
		try{
			k.obj = RPG3DObject.create3DObject( { mdlid = "EP361" });
			st.scn.addObject( k.obj);
		}catch( ex){ printexception( ex); k.obj = null; }
	}
	if( !k.obj) return;
	k.t -= dt;
	if( k.t <= 0.0){													//	twice a second: the goal and the spot
		k.t = 500.0;
		local road = this.mkRoad( st.mapid);
		k.goal = this.mkGoal( st.mapid, road);
		k.at = k.goal ? this.mkPoint( st, k.goal, road) : null;
		local key = k.goal ? "%S %.1f %.1f" % [k.goal[0], k.goal[1], k.goal[2]] : "-";
		if( key != k.key){
			k.key = key;
			printf( "[RT] marker: %S (on %S) at %S, player %.1f %.1f\n", key, st.mapid,
				k.at ? "%.1f %.1f" % [k.at[0], k.at[1]] : "-", st.player3d.pos.x, st.player3d.pos.z);
		}
	}
	if( !k.at){ this.mkHide(); return; }
	local pl = st.player3d, x = k.at[0], z = k.at[1];
	//	off screen: pin it at the screen's edge, in the goal's direction (the camera looks north: +z is up the screen)
	local dx = x - pl.pos.x, dz = z - pl.pos.z, f = 1.0;
	if( dx > 11.0 || dx < -11.0) f = Math.min( f, 11.0 / (dx < 0 ? -dx : dx));
	if( dz > 7.0) f = Math.min( f, 7.0 / dz);
	if( dz < -4.5) f = Math.min( f, 4.5 / -dz);
	x = pl.pos.x + dx * f; z = pl.pos.z + dz * f;
	//	it floats there: out from the player on a new map, then along as the goal or the screen moves, and stops
	if( !("fx" in k) || k.fstage != st){ k.fx <- pl.pos.x; k.fz <- pl.pos.z; k.fstage <- st; }
	local a = Math.min( 1.0, dt / 1000.0 * 3.0);
	k.fx += (x - k.fx) * a; k.fz += (z - k.fz) * a;
	x = k.fx; z = k.fz;
	local gy = null;
	try{ gy = ::Rokugan.floorAt( pl, x, z, pl.pos.y + 4.0, -8.0); }catch( ex){}
	local ms = skGetTime() / 1000.0;
	local y = (gy != null ? gy : pl.pos.y) + 2.2 + Math.sin( ms * 2.4) * 0.18;	//	floating, bobbing gently
	k.obj.setVisible( true);
	k.obj.setPosition( (x, y, z, 0.0));
};

::RPGStage._rt_body_mk <- ::RPGStage.updateStageBody;
::RPGStage.updateStageBody <- function( dt){
	this._rt_body_mk( dt);
	try{ ::Rokugan.mkTick( this, dt); }catch( ex){
		if( !::Rokugan.mk["err"]){ ::Rokugan.mk.err <- true; printexception( ex); }
	}
};
printf( "Rokugan quest marker loaded\n");
