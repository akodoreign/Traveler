//
//	Rokugan Traveler: equipment you can see (user: "dynamic weapons for equipping (and hats) so when players change
//	up their stuff it's visible").
//	Every traveler has a pre-drawn sprite sheet per weapon look x head look (tools/gen_sprites2d.py look_variant,
//	EP2000+; the traveler's own look keeps EP200-207). RokuganLookData.sk (generated) maps
//	"<weapon look>|<head look>" -> enemy_pic id per player id. Weapon look = the weapon's eqtype (or the item's
//	rt_look, e.g. the gaijin musket); head look = the head item's rt_look (armor.json, gen_data), "" = none.
//	Hooks:
//	- RPG3DObject.create3DObject: a traveler's model (battle members, the field leader) is built from the look.
//	- partyFollow (RokuganField.sk) asks ::Rokugan.lookFor / lookSig for the followers.
//	- the field leader is rebuilt when the look changes (after the equipment menu), outside cutscenes.
//	Native actors resolve the actual equipped item IDs and keep their native bodies with alternate weapons.
//
local srcdir = dirname( callee().getSourceName());
runsk( srcdir .. "/RokuganLookData.sk");
runsk( srcdir .. "/RokuganCostumes.sk");

::Rokugan.lookWeapon <- function( pc){
	local w = pc.getWeapon();
	if( !w) return "none";
	local d = w["data"];
	if( !d) return "none";
	if( d["rt_look"]) return d.rt_look;
	local et = d["eqtype"];
	return (et != null && (et in this.LOOK_EQTYPE)) ? this.LOOK_EQTYPE[et] : "none";
};
::Rokugan.lookHead <- function( pc){
	if( pc.dataid == "P105" || !ClientConfig.showHeadwear()) return "";
	foreach( e in pc.equips){
		local d = e ? e["data"] : null;
		if( d && (d["eqtype"] == 10 || d["eqtype"] == 11)) return d["rt_look"] ?? "";
	}
	return "";
};
//	(user) A monk's bare fists scale: past the mid game they out-hit every weapon. Bo and claws stay as they are.
::RPGPlayer._rt_basescore <- ::RPGPlayer.getBaseScoreMap;
::RPGPlayer.getBaseScoreMap <- function(){
	local bp = _rt_basescore();
	if( data["rt_class"] == "monk" && equips){
		local w = equips.find( @( v) v && ::isWeapon( v.data["eqtype"]));
		if( !w || w.dataid == "W106") bp.PATK += int( LV * LV * 0.0447) + (w ? 0 : 18);
	}
	return bp;
};

//	(user) Clan-only gear: a weapon with rt_only_clan can only be equipped by a player of that rt_clan (the Kakita blades).
//	The engine eqflag check cannot do it: getEquipFlagBits always returns 0.
::RPGPlayer._rt_equipable <- ::RPGPlayer.getEquipableItems;
::RPGPlayer.getEquipableItems <- function( slotidx, items=null){
	local clan = data["rt_clan"];
	local allowed = _rt_equipable( slotidx, items).filter( @( v) ::Rokugan.canWearCostume( this, v.data) && (!v.data["rt_only_clan"] || v.data["rt_only_clan"] == clan));
	if( dataid != "P105") return allowed;
	allowed = allowed.filter(@( v) !::Rokugan.isAdventureMask(v.dataid));
	if( slotidx != 2) return allowed;
	local candidates = items || ::rpgstat.armors;
	foreach( mask in candidates){
		if( mask && ::Rokugan.isAdventureMask(mask.dataid) && getEquipableSlot(mask.dataid) == 2)
			allowed.append(mask);
	}
	return allowed;
};
::RPGPlayer._rt_eqslot <- ::RPGPlayer.getEquipableSlot;
::RPGPlayer.getEquipableSlot <- function( itemid){
	local item = ::rpgdata[itemid];
	if( !::Rokugan.canWearCostume( this, item)) return -1;
	local only = item["rt_only_clan"];
	if( only && only != data["rt_clan"]) return -1;
	local slot = _rt_eqslot( itemid);
	if( dataid == "P105" && ::Rokugan.isAdventureMask(itemid)) return slot < 0 ? slot : 2;
	return slot;
};

//	The enemy_pic id for a player object (RPGPlayer), or null to keep the database model.
::Rokugan.lookFor <- function( pc){
	if( !pc || !(pc.dataid in this.LOOKS)) return null;
	local t = this.LOOKS[pc.dataid], w = this.lookWeapon( pc), h = this.lookHead( pc);
	return t[w .. "|" .. h] ?? t[w .. "|"] ?? null;
};
::Rokugan.lookSig <- function( pc){
	local id = null;
	try{ id = this.lookFor( pc); }catch( ex){}
	local gear = this.clothingFor( pc);
	local signature = pc.dataid .. "=" .. (id ?? "");
	if( !gear) return signature;
	return signature .. "|" .. (gear.costume || "") .. "|" .. (gear.costumeItem || "") .. "|" .. (gear.shinobiHead && ClientConfig.showHeadwear() ? "mask" : "") .. "|" .. [gear.body || "", gear.head || "", (gear.head || gear.costume) && !ClientConfig.showHeadwear() ? "hidden" : "",
		gear.mask || "", gear.cape || "",
		gear.clan || "", gear.weaponId, gear.own ? "own" : gear.weapon].join( "|");
};
//	A player definition or explicit follower context -> the live RPGPlayer.
::Rokugan.lookPlayerOf <- function( v){
	if( !v) return null;
	if( v["rt_wearer"]) return v.rt_wearer;
	if( !::rpgstat || !::rpgstat["playermap"]) return null;
	foreach( pid, player in ::rpgstat.playermap){
		if( player && player.data == v) return player;
	}
	return null;
};

::RPG3DObject._rt_create_look <- ::RPG3DObject.create3DObject;
::RPG3DObject.create3DObject <- function( v){
	if( v && (v["mdl"] || v["mdlid"])){
		local wearer = v["mdl"] ? null : ::Rokugan.lookPlayerOf( v);
		local native = ::Rokugan.createNativeChara( v, wearer);
		if( native) return native;
		local fallback = ::Rokugan.lookFor( wearer);
		if( fallback && fallback != v.mdlid && ::rpgres[fallback]){
			return ::RPG3DObject._rt_create_look( { mdlid = fallback });
		}
	}
	return ::RPG3DObject._rt_create_look( v);
};

//	Field leader: rebuild the sprite when its look changes (the equipment menu), never during a scene.
::Rokugan.lookcur <- { stage = null, sig = "" };
::Rokugan.lookCheck <- function( st){
	local pl = st["player3d"];
	if( st["battle"] || !pl || st.mainevent) return;
	local pc = pl["rpgobj"];
	if( !pc) return;
	local sig = this.lookSig( pc), c = this.lookcur;
	if( c.stage != st){ c.stage = st; c.sig = sig; return; }
	if( sig == c.sig) return;
	c.sig = sig;
	printf( "[RT] look change: %S\n", sig);
	pl.rpgobj = null;							//	changePlayer3D skips the rebuild when the same player is shown
	st.changePlayer3D( st.stat.statmap.playermodel);
};
::RPGStage._rt_body_look <- ::RPGStage.updateStageBody;
::RPGStage.updateStageBody <- function( dt){
	this._rt_body_look( dt);
	if( ::rpgstat) ::Rokugan.restoreOldWardrobe();
	try{ ::Rokugan.lookCheck( this); }catch( ex){ printexception( ex); }
};

//	Animation ids added by the v4 sheets (gen_sprites2d animap_for) fall back to an old id on sheets drawn before
//	them (monsters, nezumi, old enemy sheets), so scripts and skills can use the new ids on anyone.
local ATK_FB = [ "slash1", "punch1", "atk", "stick1" ];
local ANI_FALLBACK = { item = ["magic1", "spell"], chant = ["spell", "magic1"], collapse = ["die"],
	victory_in = ["victory"], run = ["walk"], idle = ["stand"],
	atk_slash = ATK_FB, atk_thrust = ATK_FB, atk_overhead = ATK_FB, atk_draw = ATK_FB, atk_main = ATK_FB,
	talk = ["stand"], nod = ["stand"], rei = ["stand"], rei_full = ["stand"], seiza = ["stand"], sit = ["stand"],
	seiza_rei = ["stand"], think = ["stand"], surprise = ["damage"], laugh = ["victory", "stand"] };
//	the HD sheets' conversation gestures (tools/rig_anim.py): a sheet without the gesture rows just stands
foreach( g in ["facepalm", "shrug", "crossarms", "scratch", "point"]){
	ANI_FALLBACK[g] <- ["stand"];
	ANI_FALLBACK[g + "_hold"] <- ["stand"];
}
::RPG3DPicture._rt_anime2_fb <- ::RPG3DPicture.anime2;
::RPG3DPicture.anime2 <- function( t){
	local id = t["id"];
	if( id && animemap && !animemap[id] && (id in ANI_FALLBACK)){
		foreach( alt in ANI_FALLBACK[id]){
			if( !animemap[alt]) continue;
			local t2 = clone t;
			t2.id = alt;
			return _rt_anime2_fb( t2);
		}
	}
	return _rt_anime2_fb( t);
};

// Load the subclass after installing the sprite animation fallback it inherits.
runsk( srcdir .. "/RokuganNativeChara.sk");

// Field events own these actors. The party and battles use separate creation paths.
local FIELD_NPC_SCALE = 1.25;
// The quest-badged picture IDs share the exact playable cast identities.
local sideStoryLooks = {
	EP1165 = "EP382",	// Kitsu Takeo
	EP1166 = "EP383",	// Yogo Mai
	EP1167 = "EP384",	// Ide Fujio
	EP1168 = "EP385",	// Daidoji Sakura
	EP1169 = "EP381",	// Hiruma Goro
	EP1170 = "EP380",	// Isawa Michio
	EP1171 = "EP314"		// Moto Benjiro
};
local sideStoryBadgePath = "/resource/efx/rt/side_story_question.png";
local addSideStoryBadge = function( actor){
	local icon = clone ::rpgres["EP2651"];
	icon.pic3d = sideStoryBadgePath;
	icon.scale = 0.16;
	local badge = RPG3DPicture();
	badge.setPicture( icon);
	badge.setBillboard( true);
	badge.b3body = null;
	badge.mesh.face[0].m.visiblemask = SK_VISIBLE_OPAQUE | SK_VISIBLE_TRANSPARENT;
	local top = 0.0;
	foreach( part in [actor.nativeBody, actor.nativeFace, actor.nativeHead, actor.nativeHeadband]){
		if( part) top = Math.max( top, part.bnd.y + part.bnd.s);
	}
	local offset = actor.nativeBody.pos;
	local height = Math.max( 1.0, top * actor.nativeBody.scale.y) + 0.18;
	badge.setPosition( (offset.x, offset.y + height, offset.z, 0.0));
	actor.addChild( badge);
	actor.addGroup( badge);
};
// Both stand-ins use the same Kommei mesh as their battles.
local fieldCreatureLooks = { EP435 = "EP123" };
// The older generic humanoid roles use complete native looks with already-fitted clothes.
local fieldPresets = {
	CV003 = ["EP791", "EP797"],		// Nobleman
	CV004 = ["EP821", "EP964"],		// Village girl
	CV005 = ["EP768", "EP967"],		// Woman spellcaster
	CV006 = ["EP818", "EP792"],		// Rogue
	CV007 = ["EP825", "EP879"],		// Dancer
	CV008 = ["EP740", "EP813"],		// Merchant
	CV009 = ["EP1041", "EP951"],		// Unarmed fighter
	CV014 = ["EP895", "EP745"],		// Boy
	CV018 = ["EP853", "EP998"],		// Bard
	CV019 = ["EP896", "EP779"],		// Nun
	CV021 = ["EP913", "EP812"],		// Village woman
	CV028 = ["EP978", "EP1040"],		// Farmer
	CV029 = ["EP814", "EP908"],		// Matron
	CV030 = ["EP705", "EP883"]		// Princess
};
local isFieldNpc = function( actor, data){	//	("local function" does not compile in this dialect)
	local role = data["role"];
	if( role != "villager" && role != "clerk" && role != "hotel" && role != "custom") return false;
	if( actor instanceof ::RPG3DVoxChara){
		local mot = actor.cv["mot"];
		return mot && (mot.indexOf( "/leg2") >= 0 || mot.indexOf( "/leg4") >= 0);
	}
	if( !(actor instanceof ::RPG3DPicture)) return false;
	local path = actor.pic["pic3d"];
	if( !path) return false;
	local stem = path.substring( path.lastIndexOf( "/") + 1, path.lastIndexOf( "."));
	// Several props share the custom and villager roles so that players can inspect them.
	return !stem.startsWith( "prop_") && !stem.startsWith( "decor_") &&
		stem != "powder_keg" && stem != "bloodstone_basin";
}

::RPGStageEventRunner._rt_create_field_event <- ::RPGStageEventRunner.createEventObject;
::RPGStageEventRunner.createEventObject <- function(){
	local original = this._rt_create_field_event();
	if( !original || stage["battle"] || original.rpgobj || !isFieldNpc( original, data)) return original;
	local actor = original;
	local model = data["mdlid"];
	local storyLook = model ? sideStoryLooks[model] : null;
	if( !original["nativeBody"]){
		// Existing humanoid foes keep their exact head and clothes when they appear in story scenes.
		local replacement = storyLook ? ::Rokugan.createNativeChara( { mdlid = storyLook })
			: ::Rokugan.createFieldHumanoidFoe( data);
		if( !replacement && !storyLook && model){
			// Encounter previews use the installed creature rig at its battle scale.
			local creature = ::Rokugan.createNativeFoe( { mdlid = fieldCreatureLooks[model] || model });
			if( creature && creature.creatureReady){
				creature.keepFieldInteraction( original);
				return creature;
			}
		}
		local options = model ? fieldPresets[model] : null;
		if( !replacement && options && length( options)){
			local mix = 0;
			foreach( c in evid) mix = (mix * 31 + c) & 0x7fffffff;
			local id = options[mix % length( options)];
			replacement = ::Rokugan.createNativeChara( { mdlid = id });
		}
		if( replacement){
			replacement.keepFieldInteraction( original);
			actor = replacement;
		}
	}
	actor.setFieldNpcScale( FIELD_NPC_SCALE);
	if( actor["enableFieldFidgets"] ) actor.enableFieldFidgets();
	if( storyLook && actor["nativeBodyTemplate"] && ::getResource( sideStoryBadgePath))
		addSideStoryBadge( actor);
	return actor;
};

printf( "Rokugan look plugin loaded\n");
