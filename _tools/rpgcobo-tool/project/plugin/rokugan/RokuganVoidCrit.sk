//	RokuganVoidCrit.sk (user 2026-11-12):
//	- "number of void spent increase crit chance as well and when a void spent crit happens have the bust of the char pop
//	  up with text. like Hiruma goes Dancing the razors edge, and gives everyone 20% avoid for 2 turns, for the Hida have
//	  her go The Mountain DOES NOT FALL!!! and give everyone 75 damage reduction for 2 turns etc."
//	  The Void command puts rt_vcrit (15 / 30 / 50% more criticals) on the action (RokuganBattle.sk); the first critical
//	  of such an action calls the striker's school shout: a cut-in (bust + text) and a party-wide gift for 2 turns.
//	- "make sure all the companions got the new school rank up techniques at the right levels": companion schools'
//	  effects by Insight Rank (gen_data COMP_SCHOOLS / player field rt_school_key), cumulative, COMP_FX below.

local log( s){ printf( "[RT] %S\n", s); }
local _chance = @( pct) ::rnd.nextf( 0.0, 100.0) < pct;

//	school -> [shout, party condition or a special]
::Rokugan.VOID_SHOUT <- {
	hiruma   = ["Dancing the Razor's Edge!", "K125"],
	hida     = ["The Mountain DOES NOT FALL!!!", "K126"],
	kakita   = ["Strike with No Thought!", "K127"],
	kitsuki  = ["Kitsuki's Eyes see everything!", "K131", "read"],
	akodo    = ["Akodo's Final Lesson!", "K128"],
	isawa    = ["The Void answers!", null, "vp"],
	tamori   = ["The Void answers!", null, "vp"],
	shosuro  = ["The Shadow Has No Mercy!", "K127"],
	ide      = ["The Heart Speaks!", null, "heal"],
	ronin    = ["The Wind Technique!", "K130"],
	togashi  = ["The Dragon wakes!", "K128"],
	matsu    = ["The Lion's Victory!", "K128"],
	shiba_yojimbo = ["A Single Life!", "K126"],
	seppun   = ["Heaven Never Falls!", "K126"],
	yoritomo = ["Hand of Osano-Wo!", "K128"],
	shinjo   = ["Dancing with the Fortunes!", "K130"],
	doji     = ["Eternal Justice!", "K127"],
};

//	companion schools: per Insight Rank 2..5 (cumulative) - dmg / taken multipliers, eva / crit points, hit = +1 hit,
//	haste = Speed up all battle, read = every foe's weaknesses at the start (gen_data COMP_FX_TEXT says the same)
local FX = function( dmg = 1.0, taken = 1.0, eva = 0.0, crit = 0.0, hit = 0, haste = false, read = false){
	return { dmg = dmg, taken = taken, eva = eva, crit = crit, hit = hit, haste = haste, read = read };
};
::Rokugan.COMP_FX <- {
	hida     = [FX( 1.0, 0.85), FX( 1.0, 1.0, 0, 0, 1), FX( 1.2), FX( 1.0, 0.8)],
	hiruma   = [FX( 1.15), FX( 1.0, 1.0, 15), FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 1.0, 0, 15)],
	akodo    = [FX( 1.15), FX( 1.0, 1.0, 0, 0, 1), FX( 1.1), FX( 1.0, 1.0, 0, 20)],
	matsu    = [FX( 1.2), FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 0.9), FX( 1.2)],
	shiba_yojimbo = [FX( 1.0, 0.9, 15), FX( 1.0, 1.0, 0, 0, 0, false, true),
	                 FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 0.8)],
	doji     = [FX( 1.0, 1.0, 0, 0, 0, false, true), FX( 1.2), FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 1.0, 0, 20)],
	seppun   = [FX( 1.0, 1.0, 15), FX( 1.0, 1.0, 0, 0, 0, true), FX( 1.0, 1.0, 0, 20), FX( 1.0, 0.85)],
	yoritomo = [FX( 1.15), FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 1.0, 15), FX( 1.0, 1.0, 0, 20)],
	shinjo   = [FX( 1.0, 1.0, 0, 0, 0, true), FX( 1.0, 1.0, 0, 0, 1), FX( 1.0, 1.0, 15), FX( 1.2)],
};
local TRAVELER_IDS = { P100 = 1, P101 = 1, P102 = 1, P103 = 1, P104 = 1, P105 = 1, P106 = 1, P107 = 1 };
::Rokugan.compFx <- function( pc){
	if( !(pc instanceof ::RPGPlayer) || (pc.dataid in TRAVELER_IDS)) return null;
	local t = this.COMP_FX[pc.data["rt_school_key"]];
	if( !t) return null;
	local r = 0;
	foreach( lv in [15, 30, 45, 60]) if( pc.LV >= lv) r++;
	if( !r) return null;
	local s = FX();
	for( local i = 0; i < r; i++){
		local f = t[i];
		s.dmg *= f.dmg; s.taken *= f.taken; s.eva += f.eva; s.crit += f.crit; s.hit += f.hit;
		s.haste = s.haste || f.haste; s.read = s.read || f.read;
	}
	return s;
};

///////////////////////////////////////////////////////////////////////////////
//	The title is owned by one view and removed before the attack action starts.
local CUT = { tex = null };
local cutSprite = function(){
	if( !CUT.tex){
		local img = ::getResource( "/resource/efx/battleui/white.png").getContent();
		img.premultAlpha();
		CUT.tex = Texture();
		CUT.tex.load( img, 0);
	}
	local sp = Sprite( CUT.tex);
	sp.blend = SK_PMAMIX;
	return sp;
};
class RTCutIn extends SKImageView
{
	t = 0.0;
	duration = 1500.0;
	battle = null;
	closed = false;
	parts = null;
	constructor( ms = 1500.0){
		super( cutSprite());
		enabled = false;
		duration = Math.clamp( ms, 1000.0, 2000.0);
		battle = ::rpgstage["battle"];
		parts = [];
		addUpdateFunc( this.tick.bindenv( this));
	}
	function close(){
		if( closed) return;
		closed = true;
		foreach( p in parts) p[0].removeFromParent();
		parts.clear();
		removeFromParent();
	}
	function tick( dt){
		if( closed) return false;
		t += dt;
		if( ::rpgstage["battle"] != battle || t >= duration){ close(); return false; }
		local a = Math.min( 1.0, Math.min( t / 100.0, (duration - t) / 100.0));
		setColor( 0x0b0a1200 | int( a * 0xd8));
		foreach( p in parts){
			if( p[1] == "img") p[0].setColor( 0xffffff00 | int( a * 255));
			else p[0].setColor( (p[2] & 0xffffff00) | int( a * 255));
		}
		return true;
	}
}
::RTCutIn <- RTCutIn;		//	(tester: the class lives in this file's scope; ::Rokugan.cutIn runs with this = ::Rokugan)
::Rokugan.cutIn <- function( pc, text, ms = 1500.0){
	if( !::rootview) return;
	if( ::arguments.indexOf( "-rtshotcut") >= 0){					//	test: a screenshot of each cut-in (tester)
		::Rokugan.cutn <- ("cutn" in ::Rokugan ? ::Rokugan.cutn : 0) + 1;
		local n = ::Rokugan.cutn;
		if( n <= 4) newthread().start( @(){ sleep( 600); ::Rokugan.rtshot( "tmp/rt_shot/cutin_%d.raw" % [n]); });
	}
	local root = ::rootview.findChild( "stageui");
	if( !root) return;
	local W = root.bnd.w, H = root.bnd.h, y = H * 0.30, h = H * 0.26;
	local band = ::RTCutIn( ms);
	band.setRect( 0, y, W, h);
	root.addChild( band);
	local key = ("bustKey" in this) ? this.bustKey( pc.name) : null;
	if( key){
		local emos = this["bustemos"] ? (this.bustemos[key] || []) : [];
		local file = "/resource/bust/" .. key .. "/" .. (emos.indexOf( "determined") >= 0 ? "determined" : "neutral") .. ".png";
		local tex = this.bustTexture( file);
		if( tex){
			local sp = Sprite( tex);
			sp.blend = SK_PMAMIX;
			local iv = ::SKImageView( sp), bh = h * 1.5, bw = bh * tex.width / tex.height;
			iv.enabled = false;
			iv.setRect( W * 0.06, h - bh, bw, bh);
			band.addChild( iv);
			band.parts.append( [iv, "img", 0xffffffff]);
		}
	}
	local v = SKLabelView( "", FontAttribute( Fonts.get( "ui"), 40, 0xf4e2b0ff, SK_FONT_BOLD));
	v.enabled = false;
	v.bnd.set( W * 0.32, h * 0.30, W * 0.64, h * 0.6);
	v.setText( text);
	band.addChild( v);
	band.parts.append( [v, "lbl", 0xf4e2b0ff]);
	local n = SKLabelView( "", FontAttribute( Fonts.get( "ui"), 20, 0xc9a45cff, SK_FONT_BOLD));
	n.enabled = false;
	n.bnd.set( W * 0.32, h * 0.10, W * 0.64, 26);
	n.setText( pc.name .. "  -  Void critical");
	band.addChild( n);
	band.parts.append( [n, "lbl", 0xc9a45cff]);
	::playSound( "SE209");
	return band;
};

::Rokugan.voidShout <- function( pc){
	local key = pc.data["rt_school_key"] || "", sh = this.VOID_SHOUT[key] || ["The Void strikes!", "K128"];
	local b = ::rpgstage["battle"];
	log( "VOID CRIT %S: %S" % (pc.name, sh[0]));
	foreach( m in (b ? b.members : [])){
		if( !m || m.isDead()) continue;
		if( sh[1]) m.putCondition( sh[1]);
		local sp = length( sh) > 2 ? sh[2] : null;
		if( sp == "vp"){ local st = this.state( m); st.bp = Math.min( st.bp + 1, this.vpMax( m) + 1); }
		if( sp == "heal") m.HP = Math.min( m.MAXHP, m.HP + m.MAXHP / 4);
	}
	if( length( sh) > 2 && sh[2] == "read" && b)
		foreach( e in b.enemies) if( e && !e.isDead()) this.state( e).known = this.state( e).known | this.weakbits( e);
};

///////////////////////////////////////////////////////////////////////////////
//	Presentation only: attackAction sees the final result after every combat hook.
//	Clip IDs belong to the actor's current animap, including equipment-specific pictures.
::Rokugan.CRIT_PRESENTATION <- {};
::Rokugan.registerCritical <- function( character, attack, kind, settings){
	if( kind != "critical" && kind != "void_critical") throw Exception( "Unknown critical presentation kind: " .. kind);
	this.CRIT_PRESENTATION[character .. ":" .. attack .. ":" .. kind] <- clone settings;
};
::Rokugan.criticalPlan <- function( pc, sk, isVoid, rp){
	local kind = isVoid ? "void_critical" : "critical";
	local key = sk["rt_anim_key"] || sk["atkact"]["atkani"]["id"] || "attack", cfg = {};
	local atk = sk["atkact"], weapon = rp["nativeWeaponKind"];
	local kakita = isVoid && pc.dataid == "P101" && rp["nativeBody"] && (weapon == "katana" || weapon == "kakita") &&
		typeof( atk) == SS_TABLE && atk["id"] == "atk_normal" && !atk["scp"];
	foreach( id in [pc.dataid .. ":" .. key, pc.dataid .. ":*", "*:" .. key, "*:*"]){
		local entry = this.CRIT_PRESENTATION[id .. ":" .. kind];
		if( entry){ cfg = entry; break; }
	}
	local shout = this.VOID_SHOUT[pc.data["rt_school_key"] || ""] || ["The Void strikes!"];
	local plan = { kind = kind, key = key, clip = null, ani = null, duration = 0.0,
		title = cfg["title"] || shout[0], title_ms = Math.clamp( cfg["title_ms"] ?? 1500.0, 1000.0, 2000.0) };
	local schoolClip = ::Rokugan.schoolSpecialClip( pc, sk, isVoid, rp);
	foreach( id in [cfg["clip"], (kakita ? "void_critical_kakita" : null), schoolClip, kind .. "_" .. key, kind]){
		if( !id || !rp || !rp["animemap"] || !rp.animemap[id]) continue;
		if( id == "void_critical_kakita" && !kakita) continue;
		if( id == "void_critical_yari" && id != schoolClip) continue;
		local clip = rp.animemap[id], frames = (clip["en"] ?? clip.st) - clip.st;
		if( clip["loop"] || clip["replay"] == false || frames <= 0 || clip.spd <= 0){
			log( "CRIT PRESENT invalid clip %S (requires a replayable non-looping forward range and positive speed)" % id);
			continue;
		}
		//	Complete even a long authored clip within two seconds; never change global time or its shared definition.
		local speed = Math.clamp( cfg["speed"] ?? (isVoid && id != "void_critical_kakita" ? 0.65 : 1.0), 0.35, 1.0);
		speed = Math.max( speed, frames * 1000.0 / (clip.spd * 2000.0));
		plan.clip = id;
		plan.ani = { id = id, spd = speed };
		plan.duration = frames * 1000.0 / (clip.spd * speed);
		break;
	}
	return plan;
};

//	Follow the same beats in both the hat and bareheaded motion ranges.
local smoothBeat = function( t, start, end){
	local w = Math.clamp( (t - start) / (end - start), 0.0, 1.0);
	return w * w * (3.0 - 2.0 * w);
};
::SkillCommand._rt_kakitaVoid <- function( dmg, battle, rp, plan){
	local dst = battle.getChara3D( dmg.dst), body = rp.nativeBody;
	if( !dst || !body) return false;
	local inverse = Matrix();
	rp.gmat.invert34u( inverse);
	local path = (dst.pos - rp.pos).transform0( inverse);
	local distance = Math.sqrt( path.x * path.x + path.z * path.z);
	if( distance < 0.1) return false;
	//	The picture's default facing uses its negative local Z axis.
	local heading = Math.atan2( -path.x, -path.z);
	local home = Vector3D( body.pos), homeRot = Quaternion();
	homeRot << body.rot;
	local layer = rp.anime2( plan.ani);
	if( !layer) return false;
	layer.locked = 1;
	local start = skGetTime(), hit = false, error = null;
	local atk = skill["atkact"], farSide = 0.65 / distance, strike = 0.275;
	try{
		while( ::rpgstage["battle"] == battle && rp.nativeBody == body){
			local t = Math.clamp( (skGetTime() - start) / plan.duration, 0.0, 1.0);
			local progress = (smoothBeat( t, 0.0, strike) + farSide * smoothBeat( t, strike, 0.41)) *
				(1.0 - smoothBeat( t, 0.735, 0.985));
			local turn = heading + Math.PI * smoothBeat( t, 0.40, 0.56);
			body.pos( home.x + path.x * progress, home.y + path.y * Math.min( progress, 1.0), home.z + path.z * progress);
			body.rot.setHPB( Math.HPI + turn * (1.0 - smoothBeat( t, 0.93, 1.0)), 0.0, 0.0);
			body.matdirty = true;
			if( !hit && t >= strike){
				if( atk["atkefx"]) rp.effect( atk.atkefx);
				if( atk["atksnd"]) rp.playSound( atk.atksnd);
				hit = true;
				log( "KAKITA VOID strike %S" % dmg.dst.dataid);
				this.hitAction( dmg);
			}
			if( t >= 1.0) break;
			sleep( 16);
		}
	}catch( ex){ error = ex; }
	body.pos( home);
	body.rot << homeRot;
	body.matdirty = true;
	layer.locked = 0;
	layer.animating = false;
	if( ::rpgstage["battle"] != battle) return true;
	if( rp.nativeBody == body) rp.anime2( #{id="stand"});
	if( error){
		if( hit) throw error;
		log( "KAKITA VOID unavailable; using native action: %S" % error);
	}
	if( hit) log( "KAKITA VOID complete");
	return hit;
};

::SkillCommand.rt_critShown <- false;
::SkillCommand.rt_voidShown <- false;
::SkillCommand.rt_critVisual <- null;
::SkillCommand._rt_attackAction_cp <- ::SkillCommand.attackAction;
::SkillCommand.attackAction <- function( dmg){
	local eligible = !dmg.skip && !dmg.miss && !dmg.heal && dmg.critical && dmg.skill["skilltype"] == "attack" &&
		(dmg.src instanceof ::RPGPlayer) && (dmg.dst instanceof ::RPGEnemy);
	if( !eligible) return this._rt_attackAction_cp( dmg);
	local isVoid = !!dmg.skill["rt_vcrit"];
	if( isVoid ? rt_voidShown : rt_critShown) return this._rt_attackAction_cp( dmg);
	if( isVoid) rt_voidShown = true;
	else rt_critShown = true;
	local battle = ::rpgstage["battle"], rp = battle ? battle.getChara3D( dmg.src) : null;
	local plan = ::Rokugan.criticalPlan( dmg.src, dmg.skill, isVoid, rp);
	if( isVoid){
		local band = ::Rokugan.cutIn( dmg.src, plan.title, plan.title_ms);
		if( band){
			log( "CRIT PRESENT title %S %.0fms" % (dmg.src.name, plan.title_ms));
			sleep( plan.title_ms);
			band.close();
			log( "CRIT PRESENT title cleared");
		}
	}
	if( ::rpgstage["battle"] != battle) return;
	log( "CRIT PRESENT action %S %S clip=%S" % (dmg.src.name, plan.kind, plan.clip || "native"));
	if( isVoid && ::Rokugan.useTattooDragon( dmg.src, dmg.skill, rp ) &&
		this._rt_tattooDragonVoid( dmg, ::rpgstage, battle, rp ) ) return;
	if( isVoid && ::Rokugan.canHeroLion( dmg, rp ) && this._rt_lionCourage( dmg, battle, rp ) ) return;
	if( plan.clip == "void_critical_yari"){
		if( this._rt_schoolSpearVoid( dmg, battle, rp, plan)) return;
		plan.clip = null;
	}
	if( plan.clip == "void_critical_kakita"){
		if( this._rt_kakitaVoid( dmg, battle, rp, plan)) return;
		plan.clip = null;
	}
	rt_critVisual = plan;
	try{
		this._rt_attackAction_cp( dmg);
	}catch( ex){
		rt_critVisual = null;
		throw ex;
	}
	rt_critVisual = null;
};

::SkillCommand._rt_act_cp <- ::SkillCommand.act;
::SkillCommand.act <- function( func, ctx = null){
	local plan = rt_critVisual;
	if( !func || !plan || !plan.clip || !ctx || ctx["chr"] != src || func != skill["atkact"])
		return this._rt_act_cp( func, ctx);
	//	Retain the native script's effects, projectiles and sound. Only its striker motion is replaced.
	local native = func, context = ctx;
	if( typeof( func) == SS_TABLE){
		local scp = func["scp"] || ::skillscriptmap[func["id"]];
		if( !length( scp)) return this._rt_act_cp( func, ctx);
		native = compilestring_c( scp, scp);
		context = { ...func, ...ctx };
	}
	return this._rt_act_cp( function(){
		local layer = rp3d.anime2( plan.ani);
		if( !layer){
			log( "CRIT PRESENT clip %S unavailable; using native action" % plan.clip);
			return native();
		}
		layer.locked = @() layer.animating;
		anilyr = layer;
		local start = skGetTime();
		try{
			native();
			while( layer.animating && skGetTime() - start < 2100.0) sleep( 16);
		}catch( ex){
			layer.locked = 0;
			layer.animating = false;
			throw ex;
		}
		if( layer.animating) log( "CRIT PRESENT clip %S reached playback limit" % plan.clip);
		layer.locked = 0;
		layer.animating = false;
	}, context);
};

///////////////////////////////////////////////////////////////////////////////
//	Hooks: hits (Void criticals, companion school damage / evasion / damage taken, the party's damage-taken buffs) and
//	actions (companion extra hits), battle start (companion haste / read).
::Rokugan._rt_att_vc <- ::Rokugan.onAttack;
::Rokugan.onAttack <- function( dmg){
	local src = dmg.src, dst = dmg.dst, sk = dmg.skill;
	if( !dmg.skip && !dmg.heal && sk && sk["skilltype"] == "attack"){
		if( (src instanceof ::RPGPlayer) && (dst instanceof ::RPGEnemy) && !dmg.miss){
			local f = this.compFx( src), mul = f ? f.dmg : 1.0, crit = (f ? f.crit : 0.0) + (sk["rt_vcrit"] || 0);
			if( crit > 0 && !dmg.critical && _chance( crit)){ dmg.critical = true; mul *= 1.5; }
			if( mul != 1.0) dmg.cval.baserate *= mul;
			if( dmg.critical && sk["rt_vcrit"] && !sk["rt_vfired"]){ sk["rt_vfired"] = true; this.voidShout( src); }
		}
		if( (dst instanceof ::RPGPlayer) && (src instanceof ::RPGEnemy)){
			local f = this.compFx( dst);
			if( f && !dmg.miss && f.eva > 0 && _chance( f.eva)){ dmg.miss = true; this.pop( dst, "DODGE", 0xb0d8ffff); }
			if( !dmg.miss){
				if( f) dmg.cval.baserate *= f.taken;
				foreach( c in dst.conds) if( c && c.data["rt_dmgtaken"]) dmg.cval.baserate *= c.data.rt_dmgtaken;
			}
		}
	}
	this._rt_att_vc( dmg);
};
::Rokugan._rt_pre_vc <- ::Rokugan.onPreCommand;
::Rokugan.onPreCommand <- function( cmd){
	cmd.rt_critShown = false;
	cmd.rt_voidShown = false;
	cmd.rt_critVisual = null;
	local pc = cmd.src, sk = cmd.skill;
	if( sk && (pc instanceof ::RPGPlayer) && sk["skilltype"] == "attack" && sk["flags"] == 255){
		local f = this.compFx( pc);
		if( f && f.hit > 0){
			local nsk = clone sk, na = sk["atknum"] || [1, 1];
			nsk["atknum"] <- [na[0] + f.hit, na[1] + f.hit];
			cmd.skill = nsk;
		}
	}
	this._rt_pre_vc( cmd);
};
::Rokugan._rt_preturn_vc <- ::Rokugan.onPreTurn;
::Rokugan.onPreTurn <- function( chr){
	this._rt_preturn_vc( chr);
	if( !(chr instanceof ::RPGPlayer)) return;
	local st = this.state( chr);
	if( ("vcstart" in st)) return;
	st.vcstart <- true;
	local f = this.compFx( chr), b = ::rpgstage["battle"];
	if( !f || !b) return;
	if( f.haste) chr.putCondition( "K059");
	if( f.read) foreach( e in b.enemies) if( e && !e.isDead()) this.state( e).known = this.state( e).known | this.weakbits( e);
};

printf( "Rokugan Void crits loaded\n");
