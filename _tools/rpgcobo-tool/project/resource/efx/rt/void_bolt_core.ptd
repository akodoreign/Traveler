// Native camera-facing Void Bolt mark with tracked world position.
parentcoord <- false
currentgroup <- 0
prof <- {}
groups <- [
    with ParticleGroupData(){
        name = "void_bolt_core"
        enabled = true
        aimtype = 1
        localcoord = true
        emitter = with ParticleEmitter(){
            num = 1
            start = 0, start_spr = 0
            life = 950, life_spr = 0
        },
        shapetype = 0
        shapedata = {"axis":0,"r":0.0,"w":0.69,"h":0.69}
        texture = "/resource/efx/rt/void_bolt_core.png"
        color = 0xffffffff
        blendmode = 5
        blend = 1
        Ka = 0xffffffff
        Ks = 0
        mod = [
            {"classid":"ptcmod_texanime","frame":[0,8]},
            {"classid":"ptcmod_color","color":[-1,-1,-1,-11]},
        ]
    },
]
actions <- [{"acttype":"emitall","time":0}]
