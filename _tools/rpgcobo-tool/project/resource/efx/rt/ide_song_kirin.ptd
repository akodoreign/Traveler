// Ide's original hand-drawn billboard. The scene controller floats this group.
parentcoord <- false
currentgroup <- 0
prof <- {"showbnd":[0,0,0,1,1,1],"maxbnd":[0,0,0,1,1,1],"showtime":1100,"wholebnd":[0,0,0,1,1,1]}
groups <- [
    with ParticleGroupData(){
        name = "ide_song_kirin"
        enabled = true
        aimtype = 1
        localcoord = true
        emitter = with ParticleEmitter(){
            num = 1
            start = 0, start_spr = 0
            life = 1100, life_spr = 0
            posx = 0.0, posy = 0.0, posz = 0.0
            dirx = 0.0, diry = 0.0, dirz = 0.0
            linearbits = 0
        },
        shapetype = 0
        shapedata = {"axis":0,"r":0.0,"w":1.05,"h":1.05}
        texture = "/resource/efx/rt/ide_song_kirin.png"
        color = 0xffffffff
        blendmode = 5
        blend = 1
        Ka = 0xffffffff
        Ks = 0
        mod = [
            {"classid":"ptcmod_texanime","frame":[0,8]},
            {"color":[-1,-1,-1,-256],"classid":"ptcmod_color"},
        ]
    },
]
