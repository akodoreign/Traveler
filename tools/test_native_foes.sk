// Playbot: run once on the field, then again after the battle loads.
local battle = ::rpgstage["battle"];
if( !battle){
	::RPGMain.enterBattle( { mapid="M810", escape=true, enemies=[
		{ id="E105", x=-0.5, z=0.5 }, { id="E200", x=1.5, z=-0.4 }, { id="E001", x=-2.2, z=-0.9 }
	] });
	return;
}
local seen = {};
foreach( e in battle.enemies){
	local model = battle.getChara3D( e);
	local id = e.data.mdlid;
	if( id == "EP104" || id == "EP400"){
		if( model.nativeKey != id || !model.nativeBody.motion || !model.tgtview || !model.b3body)
			throw Exception( "Native foe did not load, animate, or remain targetable: " .. id);
		if( !model.anime2( #{id="slash1"}) || !length( model.getMaterials()))
			throw Exception( "Native foe cannot attack or expose its materials: " .. id);
		model.anime2( #{id="fight"});
	}else if( id == "EP000" && model["nativeKey"]){
		throw Exception( "An unregistered foe did not fall back to its sprite");
	}
	seen[id] <- true;
}
if( !seen["EP104"] || !seen["EP400"] || !seen["EP000"]) throw Exception( "Unexpected battle fixture");
printf( "[NATIVE FOES] crab and bandit animated and targetable; original sprite fallback intact\n");
