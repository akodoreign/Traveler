// Executed only by tools (bot evalf): where the quest marker points in the Scorpion city after the mask gate.
local st = ::rpgstage;
local road = ::Rokugan.mkRoad( st.mapid);
local g = ::Rokugan.mkGoal( st.mapid, road);
printf( "[RT] MARKER TEST map %S G882 %S G883 %S goal %S\n", st.mapid, "" .. ::rpgvar["G882"], "" .. ::rpgvar["G883"],
	g ? g[0] .. " " .. g[1] .. "," .. g[2] : "none");
local p = g ? ::Rokugan.mkPoint( st, g, road) : null;
printf( "[RT] MARKER TEST floats at %S\n", p ? p[0] .. "," .. p[1] : "none");
::Rokugan.rtshot( "tmp/rt_shot/bot_scorpmarker.raw");
printf( "[RT] MARKER TEST COMPLETE\n");
