local stage = ::rpgstage;
local player = stage.player3d;
if( !player["nativeKey"]) throw Exception( "The field leader did not use a native mesh");
if( player.nativeKey != "trav_natsuko") throw Exception( "Unexpected field leader model");
if( player.nativeWeapon.mesh.bones[0] != player.nativeBody.findBone( "weapon"))
	throw Exception( "Equipment is not bound to the leader's skeleton");
local checkCel = function( model) {
	if( !model) return;
	local found = false;
	foreach( material in model.getMaterials()) {
		if( material.mtype == 0) throw Exception( "Native actor still uses standard material");
		if( material.mtype == 3) found = true;
	}
	if( !found) throw Exception( "Native actor has no cel-shaded material");
};
checkCel( player.nativeBody);
checkCel( player.nativeOutfit);
checkCel( player.nativeWeapon);
foreach( id in ["stand", "fight", "sick", "idle", "stand_f", "stand_b", "talk_b"]){
	local idle = player.animemap[id];
	local layer = AnimationLayer();
	layer.partsmap = player.nativeBody.motion.partsmap;
	layer.setAnime( idle.st, idle.en, idle.spd, idle.loop);
	local maxFrame = idle.st;
	for( local i = 0; i < 400; i++){
		layer.update( 10);
		maxFrame = Math.max( maxFrame, layer.frametime);
	}
	local firstWalk = idle.st + (idle.st == 0 ? 8 : 4);
	if( maxFrame <= idle.st + 1 || maxFrame > firstWalk - 1)
		throw Exception( "Idle is frozen or reaches a walk frame: " .. id .. " max=" .. maxFrame);
}
local count = 0;
foreach( id in ["EP201", "EP202", "EP203", "EP204", "EP205", "EP206", "EP207",
                "EP381", "EP387", "EP462"]){
	local actor = RPG3DObject.create3DObject( #{ mdlid=id });
	if( !actor["nativeKey"] || !actor.animemap["walk"] || !actor.animemap["critical"])
		throw Exception( "Missing native actor or animation: " .. id);
	checkCel( actor.nativeBody);
	count++;
}
local motion = player.anime2( #{ id="atk_thrust" });
if( !motion) throw Exception( "Native attack did not start");
local legacy = RPG3DObject.create3DObject( #{ mdlid="EP2001" });
if( !legacy || legacy["nativeKey"]) throw Exception( "Unmodeled equipment must keep its original look");
printf( "[NATIVE ROSTER] leader and %d sampled actors use skinned meshes\n", count);
