// Applied in successive bot steps so the real field refresh has time to run.
local stage = ::rpgstage;
local leader = stage.player3d.rpgobj;
local follower = ::rpgstat.playermap.P104;
local phase = ::Rokugan["gearTestPhase"] ?? 0;
::Rokugan.gearTestPhase <- phase + 1;
local equip = @( player, item) player.setEquip( player.getEquipableSlot( item), RPGObject.create( item));
local verify = @( test, message){ if( !test) throw Exception( message); };

if( phase == 0){
	verify( stage.player3d.nativeKey == "trav_natsuko", "Leader did not use the native model");
	local crab = stage.player3d;
	verify( crab.nativeGear.body == "A173" && crab.nativeOutfit && crab.nativeGear.head == "A110" && crab.nativeHead,
		"Starting Crab armor and helmet were not equipped and visible");
	local bodySlot = leader.getEquipableSlot( "A173"), headSlot = leader.getEquipableSlot( "A110");
	local render = @() RPG3DObject.create3DObject( { mdlid=leader.data.mdlid, rt_wearer=leader });
	leader.setEquip( headSlot, null);
	local bareHead = render();
	verify( bareHead.nativeOutfit && !bareHead.nativeHead, "Removing the helmet affected body armor");
	leader.setEquip( bodySlot, null);
	local bare = render();
	verify( bare.nativeBody && !bare.nativeOutfit && !bare.nativeHead, "Unequipped Natsuko did not use her wrapped body");
	equip( leader, "A110");
	local helmetOnly = render();
	verify( !helmetOnly.nativeOutfit && helmetOnly.nativeHead, "Helmet alone restored unequipped armor");
	equip( leader, "A111");
	equip( leader, "A102");
	equip( leader, "A149");
	equip( leader, "W100");
	equip( follower, "A111");
	equip( follower, "A102");
	printf( "[NATIVE GEAR] equipped shared robes and hats\n");
}else if( phase == 1){
	local crab = stage.player3d;
	verify( crab.nativeGear.body == "A111" && crab.nativeHead && crab.nativeMask, "Field leader did not refresh gear");
	verify( crab.nativeWeapon && crab.nativeGear.weapon == "katana", "Alternate weapon lost native outfit");
	verify( crab.nativeOutfit.mesh.bones[0] == crab.nativeBody.findBone( crab.nativeOutfit.mesh.wmapname[0]),
		"Outfit is not bound to the wearer rig");
	local phoenix = RPG3DObject.create3DObject( follower.data);
	local other = RPG3DObject.create3DObject( { mdlid=follower.data.mdlid, rt_wearer=follower });
	verify( phoenix.nativeGear.body == "A111" && other.nativeGear.body == "A111",
		"Party and battle actor factories skipped live equipment");
	verify( phoenix.nativeOutfit.mesh.vtx == crab.nativeOutfit.mesh.vtx, "Clan colour duplicated garment geometry");
	local crabTex = crab.nativeOutfit.mesh.face[0].m.tex0, phoenixTex = phoenix.nativeOutfit.mesh.face[0].m.tex0;
	verify( crabTex && phoenixTex && crabTex != phoenixTex, "Wearers did not get separate textures");
	verify( crab.nativeHead.mesh.face[0].m.tex0 == crabTex && phoenix.nativeHead.mesh.face[0].m.tex0 == phoenixTex,
		"Hat ignored wearer palette");
	verify( length( crab.nativeDecals) == 3 && length( phoenix.nativeDecals) == 2,
		"Missing equipped clan decals");
	local crabDecal = crab.nativeDecals[0].mesh.face[0].m, phoenixDecal = phoenix.nativeDecals[0].mesh.face[0].m;
	verify( crabDecal.tex0 && phoenixDecal.tex0 && crabDecal.tex0 != phoenixDecal.tex0 &&
		crabDecal.alphatest && phoenixDecal.alphatest, "Decals did not select the wearer clan or enable cutouts");
	verify( crab.anime2( #{ id="atk_slash" }), "Alternate weapon animation failed");
	stage.scn.addObject( phoenix);
	phoenix.pos( crab.pos.x + 1.25, crab.pos.y, crab.pos.z);
	phoenix.setDir( crab.dir);
	::Rokugan.gearTestModel <- phoenix;
	printf( "[NATIVE GEAR] shared mesh, distinct clans, bound skeleton and katana action\n");
}else if( phase == 2){
	::Rokugan.gearTestModel.kill();
	leader.setEquip( leader.getEquipableSlot( "A111"), null);
	leader.setEquip( leader.getEquipableSlot( "A102"), null);
	leader.setEquip( leader.getEquipableSlot( "A149"), null);
	leader.setEquip( leader.getEquipableSlot( "W100"), null);
	local data = decodeJSON( ::getResource( "/resource/native_gear/gear.json").loadData());
	local n = 0;
	foreach( item, slot in data.items){
		local idx = leader.getEquipableSlot( item);
		verify( idx >= 0, "Equipment cannot be tested: " .. item);
		equip( leader, item);
		local actor = RPG3DObject.create3DObject( leader.data);
		verify( actor.nativeGear[slot] == item, "Wrong equipped item or slot: " .. item);
		local parts = { body=actor.nativeOutfit, head=actor.nativeHead, mask=actor.nativeMask, cape=actor.nativeCape };
		local part = parts[slot];
		verify( part && part.mesh.face[0].m.tex0, "Missing textured garment: " .. item);
		foreach( bone in part.mesh.bones) verify( bone, "Unbound gear bone: " .. item);
		verify( length( actor.nativeDecals) == 1 && actor.nativeDecals[0].mesh.face[0].m.tex0,
			"Missing decal for " .. item);
		foreach( bone in actor.nativeDecals[0].mesh.bones) verify( bone, "Unbound decal bone: " .. item);
		leader.setEquip( idx, null);
		n++;
	}
	printf( "[NATIVE GEAR] equipped and removed all %d garments\n", n);
}else if( phase == 3){
	local actor = stage.player3d;
	verify( actor.nativeKey == "trav_natsuko" && !actor.nativeGear.body && actor.nativeBody && !actor.nativeOutfit &&
		!actor.nativeWeapon && !actor.nativeHead && !actor.nativeMask && !length( actor.nativeDecals), "Unequipping left visible gear");
	printf( "[NATIVE GEAR] restored wrapped body and unarmed rig\n");
}else if( phase == 4){
	local yosai = ::rpgstat.playermap.P132;
	local gear = decodeJSON( ::getResource( "/resource/native_gear/gear.json").loadData());
	local n = 0;
	foreach( item, kind in gear.items){
		if( kind != "head") continue;
		local slot = yosai.getEquipableSlot( item);
		verify( slot >= 0, "Headwear cannot be tested: " .. item);
		local old = yosai.equips[slot];
		equip( yosai, item);
		equip( follower, item);
		local bald = RPG3DObject.create3DObject( yosai.data);
		local hair = RPG3DObject.create3DObject( follower.data);
		verify( bald.nativeKey == "side_yosai" && bald.nativeGear.head == item && bald.nativeHead &&
			hair.nativeHead && bald.nativeHead.mesh.vtx != hair.nativeHead.mesh.vtx,
			"Yosai did not get a fitted version of " .. item);
		foreach( bone in bald.nativeHead.mesh.bones) verify( bone, "Fitted hat lost its rig: " .. item);
		yosai.setEquip( slot, old);
		n++;
	}
	printf( "[NATIVE GEAR] fitted all %d headwear designs to Yosai\n", n);
}else if( phase == 5){
	equip( leader, "A110");
	equip( leader, "A149");
	equip( follower, "A102");
	local headSlot = leader.getEquipableSlot( "A110");
	::Rokugan.gearTestHelmet <- leader.equips[headSlot];
	::Rokugan.gearTestDefense <- leader.PDEF;
	::clientconf.game.showheadwear <- 0;
}else if( phase == 6){
	local crab = stage.player3d;
	verify( crab.nativeGear.head == "A110" && !crab.nativeHead && crab.nativeMask &&
		length( crab.nativeDecals) == 1, "Hidden helmet or its decal is still visible, or mask was hidden");
	verify( leader.equips[leader.getEquipableSlot( "A110")] == ::Rokugan.gearTestHelmet &&
		leader.PDEF == ::Rokugan.gearTestDefense, "Hiding headwear changed equipment or defense");
	local companion = RPG3DObject.create3DObject( { mdlid=follower.data.mdlid, rt_wearer=follower });
	verify( companion.nativeGear.head == "A102" && !companion.nativeHead && companion.nativeOutfit &&
		length( companion.nativeDecals) == 1, "Companion hat hid incorrectly or affected the robe decal");
	::clientconf.game.showheadwear <- 1;
}else if( phase == 7){
	local crab = stage.player3d;
	verify( crab.nativeHead && crab.nativeMask && length( crab.nativeDecals) == 2,
		"Headwear did not return after turning it back on");
	verify( leader.equips[leader.getEquipableSlot( "A110")] == ::Rokugan.gearTestHelmet,
		"Showing headwear changed equipment");
	printf( "[NATIVE GEAR] toggled party headwear and decals without changing equipment or defense\n");
}
