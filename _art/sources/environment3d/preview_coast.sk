    if(length(kit.waterTextures)!=24 || !length(kit.magmaSpatter))
        throw Exception("The Lava Trees lost their animated pools");
    views=[["lava-trees",[32.4,3.20,13.96],.24,.33,17.6,55.]];
}else if(stage.mapid=="M173"){
    if(length(kit.vegetation)<35) throw Exception("The poppy animation groups did not load");
    local cluster=null, close=225.0;
    foreach(row in kit.vegetation){
        local x=row[2]-stage.player3d.pos.x, z=row[3]-stage.player3d.pos.z, dist=x*x+z*z;
        if(dist<close){ close=dist; cluster=row[0]; }
    }
    if(!cluster) throw Exception("The poppy groups are out of view");
    local initial=cluster.rot.getHPB().y;
    kit.update(380.0);
    if(Math.abs(cluster.rot.getHPB().y-initial)<.0001)
        throw Exception("The poppy group stayed still");
    views=[["poppy-fields",[34.7,3.15,11.09],.21,.46,20.8,54.]];
