    views=[["fallen-road",[32.6,2.92,15.35],.27,.64,19.2,57.],
           ["scout-waymarker",[20.5,2.64,9.28],.14,.38,8.5,53.]];
}else if(stage.mapid=="M457"){
    if(length(kit.watchfires)!=5) throw Exception("Shinomen watchfires did not load");
    views=[["shinomen-gate",[40.7,3.26,17.35],.21,.34,13.2,52.],
           ["gate-court",[29.2,3.15,12.15],.25,.57,21.8,57.]];
}else if(stage.mapid=="M991"){
    if(length(kit.watchfires)!=1 || !stage.getEvent(2)) throw Exception("The working forge or clerk is absent");
    views=[["wall-smith",[8.64,1.95,8.76],.20,.48,12.2,54.],
           ["forge-hearth",[10.8,1.87,10.19],.27,.30,7.6,46.]];
