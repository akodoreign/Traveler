    views=[["hiruma-hall-arena",[31.70,1.30,34.30],.14,.35,16.5,54.]];
}else if(stage.mapid=="M555"){
    if(!stage.getEvent(14) || length(kit.poolLighting)!=4)
        throw Exception("The garden rehearsal stage or story event did not load");
    views=[];
    foreach(name in ["komatsu","mirror","blade","title","screens"])
        views.append([name,[37.35,3.66,29.3],.12,.21,18.20,54.]);
}else if(stage.mapid=="M460"){
    if(length(kit.brushReveal)!=2) throw Exception("The two trail brambles did not load");
    local reveal=::rpgvar["G1215"];
    local expected=reveal ? 1.0 : 0.0;
    if(kit.brushReveal[0][2]!=expected || kit.brushReveal[1][2]!=expected)
        throw Exception("The brush did not match Hiruma's discovery flag");
    views=[[reveal ? "brush-open" : "brush-closed",[66.7,5.82,22.85],.44,.36,10.2,55.]];
    if(!reveal) views.append(["switchbacks",[44.2,3.39,18.26],.30,.69,22.2,56.]);
}else if(stage.mapid=="M437"){
    views=[["pilgrim-road",[54.,2.64,10.7],.17,.48,16.8,51.],
           ["lava-tube-entrance",[55.,2.79,12.35],.10,.34,10.9,48.]];
}else if(stage.mapid=="M894"){
    views=[["pilgrim-road-arena",[31.8,1.04,33.45],.19,.35,13.3,51.]];
}else{
    views=[["road",[26.7,2.04,10.15],.53,.57,12.2],["detail",[25.65,2.16,12.12],-.25,.40,5.4]];
}
local frame0=kit.waterFrame, time0=kit.seconds;
local previewProps=[];
foreach(view in views){
    if(stage.mapid=="M555"){
        foreach(obj in previewProps){ obj.setVisible(false); obj.kill(); }
        previewProps=[];
        if(view[0]=="screens"){
            foreach(x in (32.75,41.75))
                previewProps.append(kit.add("kabuki_screen_panel",x,2.5,27.70,1.0,0.0));
        }else{
            previewProps.append(kit.add("kabuki_act_"..view[0],37.25,2.5,29.75,1.0,0.0));
        }
    }
    cam.target=Vector3D(view[1][0],view[1][1],view[1][2]);
    cam.heading=view[2];
    cam.pitch=view[3];
    cam.level=view[4];
    cam.lens=length(view)>5 ? view[5] : 30.;
    sleep(480);
    screenshot(renderer,"tmp/rt_shot/bot_@STAMP@_"..view[0]..".raw");
}
foreach(obj in previewProps){ obj.setVisible(false); obj.kill(); }
if(kit.water && (kit.seconds<=time0+.15 || (kit.waterFrame==frame0 && kit.waterFrame<0)))
    throw Exception("The environment animation did not tick");
if(stage.mapid=="M103" && !kit.patronSeats[0][2])
    throw Exception("Taneo did not use the native seated pose");
if (kit.water) printf("[ENV] Liquid cycle %0.2f s with %d authored phase frames.\n",kit.waterSeconds,length(kit.waterTextures));
if(stage.mapid=="M102" && @WAVE_CLIP@){
    cam.target=Vector3D(27.1,1.28,7.30);
    cam.heading=.45; cam.pitch=.55; cam.level=8.7; cam.lens=41.;
    sleep(240);
    for(local wave=0;wave<length(kit.waterTextures);++wave){
        kit.water.mesh.face[0].m.tex0=kit.waterTextures[wave];
        screenshot(renderer,"tmp/rt_shot/bot_@STAMP@_wave"..("%02d" % wave)..".raw",1280,720);
    }
}
if(stage.mapid=="M873" && @WAVE_CLIP@){
    cam.target=Vector3D(32.0,.92,34.4);
    cam.heading=.20; cam.pitch=.36; cam.level=12.2; cam.lens=47.;
    local active=false;
    sleep(200);
    for(local frame=0;frame<26;++frame){
        foreach(pair in kit.magmaSpatter)
            if(pair[0].pos.y>pair[1][1]+.12) active=true;
        screenshot(renderer,"tmp/rt_shot/bot_@STAMP@_pop"..("%02d" % frame)..".raw",1280,720);
        sleep(70);
    }
    if(!active) throw Exception("The lava spatter did not rise");
    printf("[ENV] Captured flow and rising spatter from %d live emitters.\n",length(kit.magmaSpatter));
}
printf("[LIVE COMBAT] %S verified at 3840x2160. Water frames %d to %d. %d wind-driven plant clusters.\n",
       stage.mapid,frame0,kit.waterFrame,length(kit.vegetation));
stage.camwork.cammots.removeValue(cam);
if(battle) battle.battleui.setVisible(true);
