    views=[["grove-road-combat",[31.3,1.54,40.1],.18,.43,24.2,56.]];
}else if(stage.mapid=="M212" || stage.mapid=="M236"){
    if(!kit.water || length(kit.waterTextures)!=32)
        throw Exception("The calm tide water kit did not load");
    local raised=stage.mapid=="M212";
    views=[[raised ? "exposed-bridge" : "submerged-bridge",[43.0,2.45,12.3],.13,.57,40.5,60.],
           [raised ? "dry-west-bank" : "flooded-west-bank",[16.6,2.32,10.6],.24,.41,12.8,58.]];
