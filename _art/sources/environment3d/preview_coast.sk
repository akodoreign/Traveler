local stage=::rpgstage;
local furnaceBattle=("@MAP@"=="M873" || "@MAP@"=="M874" || "@MAP@"=="M894");
local shadowBattle=("@MAP@"=="M817" || "@MAP@"=="M818");
local marshBattle=("@MAP@"=="M862" || "@MAP@"=="M863" || "@MAP@"=="M864");
local paddyBattle="@MAP@"=="M865";
local cityBattle="@MAP@"=="M866";
local templeBattle=("@MAP@"=="M867" || "@MAP@"=="M868");
local ojataraBattle=("@MAP@"=="M869" || "@MAP@"=="M870" || "@MAP@"=="M871");
local groveBattle="@MAP@"=="M861";
local dragonBattle="@MAP@"=="M872";
local autumnBattle="@MAP@"=="M875";
local yotomoBattle=("@MAP@"=="M876" || "@MAP@"=="M877");
if(("@MAP@"=="M808" || "@MAP@"=="M811" || "@MAP@"=="M810" || "@MAP@"=="M812" || "@MAP@"=="M813" || furnaceBattle || shadowBattle || marshBattle || paddyBattle || cityBattle || templeBattle || ojataraBattle || groveBattle || dragonBattle || autumnBattle || yotomoBattle) && !stage["battle"]){
    local fire="@MAP@"=="M894" ? "E558" : "E484";
    local foes=furnaceBattle ? [{id=fire,x=1.5,z=-.4},{id=fire,x=.4,z=.65}] :
        [{id="@MAP@"=="M813" ? "E103" : ("@MAP@"=="M812" ? "E120" : ("@MAP@"=="M808" ? "E600" : "E430")),x=1.5,z=-.4}];
    if(shadowBattle) foes=[{id="E591",x=1.5,z=-.55},{id="E592",x=.45,z=.85}];
    if(paddyBattle) foes=[{id="E462",x=1.50,z=-.55},{id="E462",x=.50,z=.85}];
    if(cityBattle) foes=[{id="E470",x=1.50,z=-.55},{id="E466",x=.50,z=.85}];
    if(groveBattle) foes=[{id="E449",x=1.5,z=-.65},{id="E449",x=.45,z=.65},{id="E449",x=1.62,z=1.10}];
    if(dragonBattle) foes=[{id="E479",x=1.6,z=-.74},{id="E479",x=.52,z=.53},{id="E479",x=1.72,z=1.14}];
    if(autumnBattle) foes=[{id="E493",x=1.65,z=-.48},{id="E493",x=.55,z=.78}];
    if(yotomoBattle) foes=[{id="E497",x=1.58,z=-.48},{id="E497",x=.52,z=.72}];
    if(templeBattle) foes="@MAP@"=="M867" ?
        [{id="E466",x=1.50,z=-.55},{id="E466",x=.50,z=.85}] : [{id="E471",x=1.50,z=-.55}];
    if(ojataraBattle){
        local foe="@MAP@"=="M869" ? "E472" : ("@MAP@"=="M870" ? "E476" : "E477");
        foes=[{id=foe,x=1.50,z=-.55},{id="@MAP@"=="M871" ? "E478" : foe,x=.50,z=.85}];
    }
    if(marshBattle){
        local enemy="@MAP@"=="M862" ? "E455" : ("@MAP@"=="M863" ? "E457" : "E460");
        foes=[{id=enemy,x=1.40,z=-.55}];
        if("@MAP@"=="M863") foes.append({id=enemy,x=.50,z=.86});
    }
    ::RPGMain.enterBattle({mapid="@MAP@",escape=true,enemies=foes});
    return;
}

class CoastCamera extends RPGCameraMotion {
    target = null;
    level = 1.0;
    heading = 0.0;
    pitch = .48;
    lens = 30.;
    function update(dt){}
    function modifyCamera(cw){
        cw.to(target);
        cw.zoom = level;
        cw.hpb.x = heading;
        cw.hpb.y = pitch;
        cw.fovy = lens;
    }
}

if (stage.mapid!="@MAP@") throw Exception("Unexpected sample map " .. stage.mapid);
local kit=stage.rtEnvironmentKit;
if(!kit || ((stage.mapid=="M102" || stage.mapid=="M105" || stage.mapid=="M811") &&
           (!kit.water || length(kit.vegetation)<10)))
    throw Exception("Coast environment kit not present");
local watchCount={"M100":4,"M101":4,"M810":9};
if(stage.mapid in watchCount && length(kit.watchfires)!=watchCount[stage.mapid])
    throw Exception("Kaiu watchfire count does not match the world");
if((furnaceBattle || stage.mapid=="M384" || stage.mapid=="M385" || stage.mapid=="M386" || stage.mapid=="M437") &&
   (!kit.water || length(kit.waterTextures)!=24 || !length(kit.poolLighting) || !length(kit.magmaSpatter)))
    throw Exception("Furnace kit not present");
local cam=CoastCamera({});
stage.camwork.addMotion(cam);
local battle=stage["battle"];
if(battle) battle.battleui.setVisible(false);
local renderer=stage.view3d.renderer;
if(@DAYLIGHT@ || stage.mapid=="M100" || stage.mapid=="M810") stage.changeRenderSetting("rt_hd2d_field");
::renderhint.set(ClientConfig.renderhints[4]);
renderer.updateRenderHint(::renderhint);

function screenshot(renderer, path,w=3840,h=2160){
    local target=Texture();
    if(!skBeginRender()) throw Exception("No render thread for 4K frame");
    target.create(w,h,SK_RGBA8,2,0);
    skPushRenderStates();
    local old=skSetRenderTarget(target);
    skClearScreen(#ClearParam(0,0,0,1));
    renderer.render((0,0,w,h));
    local width=renderer.rtw, height=renderer.rth;
    skSetRenderTarget(old);
    skPopRenderStates();
    skEndRender();
    if(width!=w || height!=h) throw Exception("The 3D target did not render at 4K");
    local pixels=PixelBuffer(), waits=0;
    while(!pixels.readPixels(target,0,0,w,h)){
        if(++waits>90) throw Exception("4K pixel buffer stalled");
        suspend();
    }
    while(!pixels.isDone()) suspend();
    local result=ByteBuffer();
    result.endian=0;
    result.puti(w);
    result.puti(h);
    result.putBuffer(pixels.getData());
    result.pos=0;
    FileRef(path).save(result);
    if(w==3840) printf("[ENV] 4K frame %S\n",path);
}

local views;
if(@DOORS@){
    local store=null, regular=null;
    foreach(row in kit.townDoors){
        if(row[0]==20) store=row;
        if(row[0]==16) regular=row;
    }
    if(!store || !regular || !(regular[2]>.80))
        throw Exception("An accessible town doorway is still shut");
    local haskey=::reqchk({lvar="NUM_I573",op=">=",rvar=1});
    if(haskey ? !(store[2]>.80) : store[2]!=0.0)
        throw Exception("Storehouse door does not match the key state");
    views=[[haskey ? "storehouse-ajar" : "storehouse-locked",
            [32.01,3.29,18.03],.10,.17,6.1,49.]];
    if(!haskey)
        views.append(["street-doorways",[42.20,3.18,9.31],.15,.27,13.3,57.]);
}else if(@ENTRANCE@){
    local coast=stage.mapid!="M437";
    local x=coast ? 48.23 : 55.25;
    local z=coast ? 13.5 : 13.0;
    if(!stage.player3d || stage.player3d.pos.z<z+2.05 || stage.player3d.pos.y>3.1 ||
       Math.abs(stage.player3d.pos.x-x)>1.2)
        throw Exception("The party could not walk beneath the cave roof");
    printf("[ENV] Entered the recessed passage on foot at %S.\n",stage.player3d.pos);
    views=[["recessed-entrance",[x,2.95,z+1.65],.23,.28,8.4,56.],
           ["tunnel-interior",[x,2.29,z+2.61],.03,.09,5.8,56.]];
